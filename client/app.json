{
  "expo": {
    "name": "paddleerg",
    "slug": "paddleerg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paddleerg",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paddleerg.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "paddleerg connects to your Whipr paddle machine over Bluetooth to show workout metrics.",
        "NSBluetoothPeripheralUsageDescription": "paddleerg connects to your Whipr paddle machine over Bluetooth to show workout metrics."
      }
    },
    "android": {
      "package": "com.paddleerg.app",
      "adaptiveIcon": {
        "backgroundColor": "#071525",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#071525"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Allow paddleerg to connect to your Whipr over Bluetooth"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
